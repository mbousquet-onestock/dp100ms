{
  "info": {
    "name": "Delivery Promise API (dp100ms)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Delivery Promise & Multi-Leg Routing Engine. Set the collection variables baseUrl (e.g. https://<project>.vercel.app/api/v1 or http://localhost:8080/api/v1) and adminToken (ADMIN_TOKEN). Write requests (POST/PUT/DELETE on configuration, reseed) use the admin bearer token; reads and promises are public. Full reference: GET {{baseUrl}}/openapi.json (can be imported in Postman too)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminToken",
      "value": "dev-admin-token"
    }
  ],
  "item": [
    {
      "name": "1. Promesse de livraison",
      "item": [
        {
          "name": "Promesse — 3 modes, Lyon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/delivery-promises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery-promises"
              ]
            },
            "description": "Best route per selected mode (bestByMode) with cost, delay, carrier, service, carrier route and shipping points, plus the detailed options.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": {\n    \"postalCode\": \"69003\",\n    \"country\": \"FR\"\n  },\n  \"orderDate\": \"2026-10-12T10:00:00+02:00\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-00002\",\n      \"quantity\": 2\n    },\n    {\n      \"sku\": \"SKU-00007\",\n      \"quantity\": 1\n    }\n  ],\n  \"deliveryModes\": [\n    \"STANDARD\",\n    \"EXPRESS\",\n    \"RELAY\"\n  ],\n  \"maxOptions\": 3,\n  \"alternatives\": {\n    \"limit\": 3,\n    \"sortBy\": \"deliveryHours\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('best route per mode', () => pm.expect(r.bestByMode).to.be.an('array'));",
                  "pm.test('calculation time header', () => pm.expect(pm.response.headers.get('X-Calculation-Time-Ms')).to.exist);",
                  "r.bestByMode.forEach(b => console.log(b.deliveryMode, b.carriers.map(c => c.serviceName).join(','), b.estimatedDelivery.to, b.cost + ' €', b.shippingPoints.join(',')));"
                ]
              }
            }
          ]
        },
